# Speech Coach Backend Environment Configuration
# Copy this file to .env and update with your actual values

# ================================
# Server Configuration
# ================================
SERVER_HOST=0.0.0.0
SERVER_PORT=5005
DEBUG_MODE=True

# ================================
# Frontend CORS Configuration
# ================================
FRONTEND_URL=http://localhost:3000

# ================================
# Database Configuration (PostgreSQL)
# ================================
# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=speech_coach
DATABASE_USER=postgres
DATABASE_PASSWORD=speech_coach_password

# Option 2: Complete database URL (overrides individual parameters)
# DATABASE_URL=postgresql://username:password@localhost:5432/speech_coach

# ================================
# Auth0 Configuration
# ================================
# Required: Basic Auth0 settings
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_AUDIENCE=your-api-audience
AUTH0_ALGORITHMS=RS256

# Optional: Auth0 Management API (for fetching user profiles)
AUTH0_MANAGEMENT_CLIENT_ID=your-management-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=your-management-client-secret

# ================================
# File Storage
# ================================
UPLOAD_FOLDER=uploads

# ================================
# Google Cloud Storage Configuration
# ================================
GCS_BUCKET_NAME=speech-coach-files
GCS_CREDENTIALS_PATH=key.json

# Optional: Override the public URL base if needed
# GCS_PUBLIC_URL_BASE=https://storage.googleapis.com/your-custom-bucket

# ================================
# LLM Configuration
# ================================
LLM_ENDPOINT=http://localhost:11434/api/generate
LLM_MODEL=llama3
LLM_TEMPERATURE=0.3

# ================================
# MCP Protocol Configuration
# ================================
MCP_PROTOCOL_VERSION=2025-06-18

# ================================
# Service Account Configuration
# ================================
SERVICE_ACCOUNT_KEY_PATH=key.json
REGION=us-central1
